# ==========================================
# 3-TIER APPLICATION BACKEND ENVIRONMENT CONFIG
# ==========================================

# Tier 2 Application Port
PORT=5000
NODE_ENV=development

# Tier 3 Database Configuration (AWS RDS PostgreSQL)
# For local testing without RDS, leave DB_HOST blank to use in-memory mode.
# When AWS RDS is deployed, update with your RDS endpoint:
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourSecurePassword123!
DB_NAME=threetierdb
DB_SSL=false

# AWS Region & Metadata
AWS_REGION=ap-south-1
SERVER_IP=10.0.10.45
